:root {
  --background: #ffffff;
  --foreground: #0d0806;
  --color-orange: #ff6420;
  --color-orange-light: #ffaa60;
  --color-orange-glow: rgba(255, 100, 32, 0.1);
  --color-orange-border: rgba(255, 100, 32, 0.2);
  --color-light: #ffffff;
  --color-light-warm: #faf7f4;
  --color-light-mid: #f0ebe4;
  --color-light-muted: #e8e0d8;
  --color-light-border: #e2d9d0;
  --color-text-dark: #0d0806;
  --color-text-muted: #4a3f38;
  --color-gray-light: #9a9099;
}
.dark {
  --background: #0d0806;
  --foreground: #f5ede4;
  --color-dark: #0d0806;
  --color-orange-light: #ffaa60;
  --color-dark-mid: #1a0d04;
  --color-dark-subtle: #0f0a07;
  --color-dark-muted: #2a1f18;
  --color-offwhite: #f5ede4;
  --color-gray: #888899;
}
body {
  background: var(--background);
  color: var(--foreground);
  font-family: var(--font-body);
}
@keyframes floatSmooth {
  0%,
  100% {
    transform: translateY(0px);
  }
  50% {
    transform: translateY(-12px);
  }
}
.animate-float {
  animation: floatSmooth 3s ease-in-out infinite;
}
@keyframes marquee {
  from {
    transform: translateX(0%);
  }
  to {
    transform: translateX(-50%);
  }
}
.animate-marquee {
  animation: marquee 25s linear infinite;
}
.nav-link {
  position: relative;
  font-size: var(--text-sm);
  line-height: var(--tw-leading, var(--text-sm--line-height));
  color: #4a3f38;
  transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, --tw-gradient-from, --tw-gradient-via, --tw-gradient-to, opacity, box-shadow, transform, translate, scale, rotate, filter, -webkit-backdrop-filter, backdrop-filter, display, content-visibility, overlay, pointer-events;
  transition-timing-function: var(--tw-ease, var(--default-transition-timing-function));
  transition-duration: var(--tw-duration, var(--default-transition-duration));
  &:where(.dark, .dark *) {
    color: #888899;
  }
}
.nav-link:hover {
  color: var(--foreground);
}
.nav-active {
  color: var(--foreground);
  &:where(.dark, .dark *) {
    color: #f5ede4;
  }
}
.nav-link::after {
  content: "";
  position: absolute;
  left: 0;
  bottom: -6px;
  width: 0%;
  height: 2px;
  background: #ff6420;
  transition: width 0.3s ease;
}
.nav-link:hover::after {
  width: 100%;
}
.nav-active::after {
  width: 100%;
}
.mobile-link {
  display: block;
  border-radius: var(--radius-xl);
  padding-inline: calc(var(--spacing) * 4);
  padding-block: calc(var(--spacing) * 3);
  transition-property: color, background-color, border-color, outline-color, text-decoration-color, fill, stroke, --tw-gradient-from, --tw-gradient-via, --tw-gradient-to, opacity, box-shadow, transform, translate, scale, rotate, filter, -webkit-backdrop-filter, backdrop-filter, display, content-visibility, overlay, pointer-events;
  transition-timing-function: var(--tw-ease, var(--default-transition-timing-function));
  transition-duration: var(--tw-duration, var(--default-transition-duration));
  color: #0d0806;
  &:where(.dark, .dark *) {
    color: #f5ede4;
  }
}
.mobile-link:hover {
  background-color: #faf7f4;
  &:where(.dark, .dark *) {
    background-color: #1a0d04;
  }
}
.mobile-active {
  background-color: color-mix(in oklab, #ff6420 10%, transparent);
  color: #ff6420;
}
.mobile-active {
  border-left: 3px solid #ff6420;
  padding-left: calc(1rem - 3px);
}
